{
  "rules": {
    "pengaturan": {
      "$undangan": {
        ".read": true,
        ".write": "auth != null && auth.token.email == 'darkan@admin.undangan'",
        ".validate": "newData.hasChildren(['bagian','rekeningAktif','teksWA'])",
        "bagian": {
          ".validate": "newData.hasChildren(['rsvp','turutMengundang'])",
          "rsvp": { ".validate": "newData.isBoolean()" },
          "turutMengundang": { ".validate": "newData.isBoolean()" },
          "$lain": { ".validate": false }
        },
        "rekeningAktif": {
          "$index": { ".validate": "newData.isBoolean()" }
        },
        "teksWA": { ".validate": "newData.isString() && newData.val().length <= 5000" },
        "$lain": { ".validate": false }
      }
    },
    "ucapan": {
      "$undangan": {
        ".read": true,
        "$id": {
          ".write": "!data.exists() || (auth != null && auth.token.email == 'darkan@admin.undangan')",
          ".validate": "newData.hasChildren(['n','u','h','t'])",
          "n": { ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 50" },
          "u": { ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 300" },
          "h": { ".validate": "newData.val() == 'Hadir' || newData.val() == 'Tidak Hadir' || newData.val() == 'Masih Ragu'" },
          "t": { ".validate": "newData.isNumber()" },
          "$lain": { ".validate": false }
        }
      }
    }
  }
}
